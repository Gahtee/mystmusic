# Modelo — copie para .env e preencha
# cp .env.example .env   (se não existir, crie conforme abaixo)

TOKEN=seu_token_do_bot
CLIENT=seu_client_id
GUILDS=ids_das_guilds_permitidas,separados_por_virgula
OWNER_IDS=seu_user_id_do_discord
# Opcional:
# cookies.txt na raiz (cookies do YouTube exportados) — melhora extração

# ── Opcionais do bot 2 / comportamento ──
# PREFIX=!
# PM2_NAME=mystmusic
# ENABLE_SLASH=1

# ── Spotify Web API (opcional, p/ playlists >50 faixas) ──
# 1. Crie um app em https://developer.spotify.com/dashboard
#    (qualquer nome/descrição; serve só p/ ler metadados públicos).
# 2. Copie o Client ID e o Client Secret para as linhas abaixo.
# 3. Restart: pm2 restart mystmusic
# Como usa: fluxo Client Credentials (server-to-server, sem login de usuário):
#   POST https://accounts.spotify.com/api/token
#     Authorization: Basic base64(CLIENT_ID:CLIENT_SECRET)
#     Content-Type: application/x-www-form-urlencoded, body grant_type=client_credentials
#   → { "access_token": "...", "token_type": "Bearer", "expires_in": 3600 }
#   GET https://api.spotify.com/v1/playlists/{id}/tracks?limit=100&offset=0
#   GET https://api.spotify.com/v1/albums/{id}/tracks?limit=50&offset=0
#     Authorization: Bearer <access_token>
#   (paginar offset até total — sem teto de 50/100; playlist privada precisa
#   de login OAuth, Client Credentials só lê conteúdo público).
# Sem isso: o bot cai no embed público open.spotify.com/embed (~50 faixas por
# playlist, ~10 top tracks por artista).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
