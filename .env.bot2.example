# Segundo bot (frontend 2) — divide o MESMO db/*.db com o principal.
# Uso: DOTENV_FILE=.env.bot2 pm2 start src/index.js --name mystmusic2
# Ou: pm2 start ecosystem.config.js (sobe os dois de uma vez).

# App/bot 2 criado no Developer Portal (token + client ID DIFERENTES do .env)
TOKEN=seu_token_do_segundo_bot
CLIENT=seu_client_id_do_segundo_bot

# Mesmos servidores (ou restrinja se quiser)
GUILDS="849794289805295617"
OWNER_IDS=214513653033074688

# ── O que diferencia o bot 2 ──
# Prefixo de texto: principal escuta "!", este escuta "."
PREFIX=.
# Nome no pm2 (para o .botmorreu reiniciar só ele)
PM2_NAME=mystmusic2
# 0 = ignora /slash (evita /play duplicado — cada app registra os seus;
# o Discord mostraria 2 entradas de /play). Use os /slash pelo bot 1 e
# os comandos de texto pelo prefixo de cada um (! no 1, . no 2).
ENABLE_SLASH=0
